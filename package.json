{
  "name": "@meddleware/ui",
  "version": "0.1.26",
  "description": "Shared Vue 3 component library for @meddleware UIs — layout shell (header/sidebar/footer), colour-mode control, and primitives. Built on @meddleware/design-tokens.",
  "homepage": "https://docs.meddleware.co.uk/",
  "license": "0BSD",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "main": "./dist/ui.js",
  "module": "./dist/ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/ui.js"
    },
    "./base.css": "./dist/base.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && vue-tsc -p tsconfig.build.json && vite build",
    "type-check": "vue-tsc --noEmit",
    "lint:css": "stylelint \"src/**/*.{css,vue}\"",
    "lint:js": "eslint .",
    "lint": "npm run lint:css && npm run lint:js",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@meddleware/design-tokens": "^0.1.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.0",
    "vitest": "~5.0.1",
    "vitest-axe": "^0.1.0",
    "vue": "^3.5.43",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "~3.3.11"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead"
  ],
  "publishConfig": {
    "access": "public"
  }
}
