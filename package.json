{
  "name": "@meddleware/ui",
  "version": "0.1.21",
  "description": "Shared Vue 3 component library for @meddleware UIs \u2014 layout shell (header/sidebar/footer), colour-mode control, and primitives. Built on @meddleware/design-tokens.",
  "homepage": "https://docs.meddleware.co.uk/",
  "license": "0BSD",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "main": "./dist/ui.js",
  "module": "./dist/ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/ui.js"
    },
    "./base.css": "./dist/base.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && vue-tsc -p tsconfig.build.json && vite build",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@meddleware/design-tokens": "^0.1.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "^6.0.0",
    "vite": "^8.3.0",
    "vitest": "~5.0.1",
    "vue": "^3.5.43",
    "vue-tsc": "~3.3.11"
  },
  "publishConfig": {
    "access": "public"
  }
}