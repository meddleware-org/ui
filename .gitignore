# Files git must never track in this package. `dist/` is the build output npm consumers receive, built by `npm run build`, never committed.
node_modules/
dist/
# The component gallery's build output (`npm run build:gallery`), served only for the browser tests.
gallery-dist/
# Playwright's reports, traces and screenshots from a local or CI run.
test-results/
playwright-report/
# A tarball from `npm pack`.
*.tgz
